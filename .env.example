# Banco de dados
# - Rodando a app LOCALMENTE (uvicorn na maquina): use localhost:5433 (porta mapeada do compose)
# - Rodando a app NO CONTAINER (docker compose up): o compose sobrescreve para db:5432 automaticamente
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutriz_ia

# JWT (mesma secret que o backend Go usa para emitir tokens)
JWT_SECRET=
JWT_ALGORITHM=HS256

# LLM Provider Strategy: groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Ollama (fallback dev) - no container o compose sobrescreve para http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Modelos
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2:3b

# Diretorio do artefato de embeddings ONNX (model.onnx podado + tokenizer.json).
# Na imagem Docker fica em /models (baixado do GitHub Release no build).
EMBEDDINGS_MODEL_DIR=/models

# Boot: aplicar migrations e/ou ingerir protocolos na subida.
# Local (compose) = true nos dois. Producao (Render) = false (schema via
# docs/migracao-neon.sql e ingestao one-off; o servico nao toca no banco do Go).
RUN_MIGRATIONS=true
RUN_INGESTION=false

APP_ENV=development
LOG_LEVEL=INFO

# Modo publico (chat anonimo sem login)
ANON_SESSION_TTL_MINUTES=30
ANON_RATE_LIMIT_PER_IP_HOUR=30
ANON_RATE_LIMIT_PER_SESSION=10
ANON_MAX_JAILBREAK_STRIKES=3

# CORS: origens permitidas (front Vite). Lista separada por virgula.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Testes: URL do banco de teste (opcional; default usa o mesmo Postgres do compose)
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutriz_ia_test
